# DO NOT EDIT!
#
# This file is generated by Terraform.
# See https://github.com/dogmatiq/repos.

version: 2
%{ if contains(ecosystems, "apm") ~}
# APM is a beta ecosystem in Dependabot, which fails to update it without this
# setting.
enable-beta-ecosystems: true
%{ endif ~}
updates:
  %{~ for ecosystem in ecosystems ~}
  - package-ecosystem: ${ecosystem}
    directory: "/"
    schedule:
      interval: daily
    open-pull-requests-limit: 10
    %{~ if contains(keys(cooldown_exclusions), ecosystem) ~}
    # Our own packages are exempt from the default 3-day cooldown, since there is
    # nothing to wait out for a release we made ourselves.
    cooldown:
      default-days: 3
      exclude:
        %{~ for pattern in cooldown_exclusions[ecosystem] ~}
        - "${pattern}"
        %{~ endfor ~}
    %{~ endif ~}
    %{~ if contains(keys(pre_approved_patterns), ecosystem) ~}
    # Minor and patch updates to pre-approved dependencies are grouped into a
    # single pull request (one for version updates, one for security updates),
    # which is merged automatically.
    groups:
      %{~ for group, applies_to in { "pre-approved" = "version-updates", "pre-approved-security" = "security-updates" } ~}
      ${group}:
        applies-to: ${applies_to}
        update-types:
          - minor
          - patch
        patterns:
          %{~ for pattern in pre_approved_patterns[ecosystem] ~}
          - "${pattern}"
          %{~ endfor ~}
      %{~ endfor ~}
    %{~ endif ~}
  %{~ endfor ~}
