# DO NOT EDIT!
#
# This file is generated by Terraform.
# See https://github.com/dogmatiq/repos.

version: 2
%{ if contains(ecosystems, "apm") ~}
# APM is a beta ecosystem in Dependabot, which fails to update it without this
# setting.
enable-beta-ecosystems: true
%{ endif ~}
updates:
  %{~ for ecosystem in ecosystems ~}
  - package-ecosystem: ${ecosystem}
    directory: "/"
    schedule:
      interval: daily
    open-pull-requests-limit: 10
    %{~ if ecosystem == "apm" ~}
    # Our own agent-config packages are not subject to the cooldown, since
    # there is nothing to wait out for a release we made ourselves.
    cooldown:
      default-days: 3
      exclude:
        - "dogmatiq/agent-config*"
    %{~ endif ~}
  %{~ endfor ~}
