# DO NOT EDIT!
#
# This file is generated by Terraform.
# See https://github.com/dogmatiq/repos.

name: Continuous Integration

on:
  push:
  pull_request:
  workflow_dispatch:
  schedule:
    - cron: 0 14 * * 0

# Let CI runs proceed independently by default. For pull requests and pushes
# to non-default branches, a new first attempt cancels older pending or
# running first attempts for the same PR or branch.
concurrency:
  # First attempts for a PR share its merge ref. First attempts for pushes
  # to a non-default branch share the branch ref. These refs keep push and PR
  # runs independent, and the workflow name scopes each group to this workflow.
  #
  # All other attempts get a group based on the run ID and attempt number.
  # This lets default-branch pushes, tag pushes, scheduled runs, and manual
  # runs proceed independently. A shared group can replace a pending run even
  # when cancel-in-progress is false.
  #
  # GitHub starts a new run at attempt 1. Rerunning jobs keeps the original
  # event, commit, and run ID and increments the attempt number. Giving
  # reruns their own group lets an old commit be retried alongside CI for a
  # newer commit.
  group: >-
    $${{ github.workflow }}-$${{
      (
        github.run_attempt == 1 &&
        (
          github.event_name == 'pull_request' ||
          (
            github.event_name == 'push' &&
            github.ref_type == 'branch' &&
            github.ref_name != github.event.repository.default_branch
          )
        ) &&
        github.ref
      ) ||
      format('run-{0}-{1}', github.run_id, github.run_attempt)
    }}
  cancel-in-progress: true

jobs:
  ci:
    name: Shared
    uses: dogmatiq/repos/.github/workflows/shared-${workflow.name}.yml@main
    secrets: inherit
    %{~ if length(workflow.services) != 0 ~}
    with:
    %{~ for service in workflow.services ~}
      "${service}": true
    %{~ endfor}
    %{endif ~}
