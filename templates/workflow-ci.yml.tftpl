# DO NOT EDIT!
#
# This file is generated by Terraform.
# See https://github.com/dogmatiq/repos.

name: Continuous Integration

on:
  push:
  pull_request:
  workflow_dispatch:
  schedule:
    - cron: 0 14 * * 0

# Cancel older CI runs when a new run's results will take precedence.
concurrency:
  cancel-in-progress: true

  # Concurrency groups control which CI runs can cancel each other. With
  # cancel-in-progress enabled, a new run cancels older queued or running
  # runs in the same group.
  #
  # Group automatic runs for the same pull request or pushes to the same
  # non-default branch. Pushing to a branch with an open PR can start both a
  # branch check and a check of what would be merged. Those checks use separate
  # groups.
  #
  # Give default-branch pushes, tag pushes, scheduled runs, and runs you start
  # manually their own groups so they can finish independently.
  #
  # "Re-run jobs" retries the original commit. The run ID and attempt number
  # give each retry its own group so it can finish alongside newer CI runs.
  group: >-
    $${{ github.workflow }}-$${{
      (
        github.run_attempt == 1 &&
        (
          github.event_name == 'pull_request' ||
          (
            github.event_name == 'push' &&
            github.ref_type == 'branch' &&
            github.ref_name != github.event.repository.default_branch
          )
        ) &&
        github.ref
      ) ||
      format('run-{0}-{1}', github.run_id, github.run_attempt)
    }}

jobs:
  ci:
    name: Shared
    uses: dogmatiq/repos/.github/workflows/shared-${workflow.name}.yml@main
    secrets: inherit
    %{~ if length(workflow.services) != 0 ~}
    with:
    %{~ for service in workflow.services ~}
      "${service}": true
    %{~ endfor}
    %{endif ~}
