# DO NOT EDIT!
#
# This file is generated by Terraform.
# See https://github.com/dogmatiq/repos.

name: Continuous Integration

on:
  push:
  pull_request:
  workflow_dispatch:
  schedule:
    - cron: 0 14 * * 0

# By default, each run attempt gets its own group from its run ID and attempt
# number. This lets default-branch pushes, tag pushes, scheduled runs, manual
# runs, and reruns proceed independently. A shared group can replace a pending
# run even when cancel-in-progress is false.
#
# First attempts for a pull request share its merge ref. First attempts for
# pushes to a non-default branch share the branch ref. A new run in either
# group cancels older pending and in-progress runs in that group. The two refs
# keep push and PR runs independent, and the workflow name scopes each group
# to this workflow.
#
# GitHub starts a new run at attempt 1. Rerunning jobs keeps the original event,
# commit, and run ID and increments the attempt number. Giving reruns their own
# group lets an old commit be retried alongside CI for a newer commit.
concurrency:
  group: >-
    $${{ github.workflow }}-$${{
      (
        github.run_attempt == 1 &&
        (
          github.event_name == 'pull_request' ||
          (
            github.event_name == 'push' &&
            github.ref_type == 'branch' &&
            github.ref_name != github.event.repository.default_branch
          )
        ) &&
        github.ref
      ) ||
      format('run-{0}-{1}', github.run_id, github.run_attempt)
    }}
  cancel-in-progress: true

jobs:
  ci:
    name: Shared
    uses: dogmatiq/repos/.github/workflows/shared-${workflow.name}.yml@main
    secrets: inherit
    %{~ if length(workflow.services) != 0 ~}
    with:
    %{~ for service in workflow.services ~}
      "${service}": true
    %{~ endfor}
    %{endif ~}
