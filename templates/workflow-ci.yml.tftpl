# DO NOT EDIT!
#
# This file is generated by Terraform.
# See https://github.com/dogmatiq/repos.

name: Continuous Integration

on:
  push:
  pull_request:
  workflow_dispatch:
  schedule:
    - cron: 0 14 * * 0

# Update a pull request or push to a non-default branch and the new automatic
# run cancels older automatic runs that are queued or running for that same
# PR or branch. Pushes to the default branch, tag pushes, scheduled runs, and
# runs you start manually can all finish independently.
concurrency:
  # A push to a non-default branch with an open PR can start two runs. One
  # checks the branch commit and the other checks what would be merged. Each
  # can cancel older runs of its own kind, leaving both checks for the latest
  # push free to finish.
  #
  # Use "Re-run jobs" to retry the same commit. GitHub counts that as another
  # attempt at the original run. The retry and CI for newer changes can run
  # alongside each other.
  group: >-
    $${{ github.workflow }}-$${{
      (
        github.run_attempt == 1 &&
        (
          github.event_name == 'pull_request' ||
          (
            github.event_name == 'push' &&
            github.ref_type == 'branch' &&
            github.ref_name != github.event.repository.default_branch
          )
        ) &&
        github.ref
      ) ||
      format('run-{0}-{1}', github.run_id, github.run_attempt)
    }}
  cancel-in-progress: true

jobs:
  ci:
    name: Shared
    uses: dogmatiq/repos/.github/workflows/shared-${workflow.name}.yml@main
    secrets: inherit
    %{~ if length(workflow.services) != 0 ~}
    with:
    %{~ for service in workflow.services ~}
      "${service}": true
    %{~ endfor}
    %{endif ~}
