+func createTestProjectToken(t *testing.T, r *ProjectTokenResource, schema frameworkresource.SchemaResponse) frameworkresource.CreateResponse {
+	t.Helper()
+	plan := tfsdk.Plan{Schema: schema.Schema}
+	data := ProjectTokenResourceModel{
+		Id: types.StringUnknown(), Name: types.StringValue("CI"), ProjectId: types.StringValue(tokenTestProject),
+		EnvironmentId: types.StringValue(tokenTestEnvironment), Token: types.StringUnknown(), TokenId: types.StringUnknown(),
+	}
+	if diagnostics := plan.Set(context.Background(), &data); diagnostics.HasError() {
+		t.Fatal(diagnostics)
+	}
+	response := frameworkresource.CreateResponse{State: tfsdk.State{Schema: schema.Schema}}
+	r.Create(context.Background(), frameworkresource.CreateRequest{Plan: plan}, &response)
+	return response
+}
