+func TestProjectTokenTerraform(t *testing.T) {
+	fixture := newProjectTokenFixture(t)
+	factories := map[string]func() (tfprotov6.ProviderServer, error){
+		"railway": providerserver.NewProtocol6WithError(&projectTokenMockProvider{client: fixture.client}),
+	}
+	config := func(name, project, environment string) string {
+		return fmt.Sprintf(`resource "railway_project_token" "test" {
+  name = %q
+  project_id = %q
+  environment_id = %q
+}`, name, project, environment)
+	}
+	checkCount := func(expected int) resource.TestCheckFunc {
+		return func(state *terraform.State) error {
+			fixture.mu.Lock()
+			defer fixture.mu.Unlock()
+			if fixture.creates != expected || len(fixture.tokens) != 1 {
+				return fmt.Errorf("unexpected token lifecycle: creates=%d active=%d", fixture.creates, len(fixture.tokens))
+			}
+			return nil
+		}
+	}
+	initial := config("CI", tokenTestProject, tokenTestEnvironment)
+	renamed := config("Renamed", tokenTestProject, tokenTestEnvironment)
+	resource.UnitTest(t, resource.TestCase{
+		ProtoV6ProviderFactories: factories,
+		Steps: []resource.TestStep{
+			{Config: initial, Check: checkCount(1)},
+			{Config: initial, PlanOnly: true},
+			{Config: renamed, Check: checkCount(2)},
+			{
+				PreConfig: func() {
+					fixture.mu.Lock()
+					defer fixture.mu.Unlock()
+					fixture.tokens = map[string]ProjectTokenInfo{}
+				},
+				Config: renamed,
+				Check:  checkCount(3),
+			},
+			{Config: config("Renamed", "10000000-0000-0000-0000-000000000002", tokenTestEnvironment), Check: checkCount(4)},
+			{Config: config("Renamed", "10000000-0000-0000-0000-000000000002", "20000000-0000-0000-0000-000000000002"), Check: checkCount(5)},
+			{Config: config("Renamed", "invalid", tokenTestEnvironment), ExpectError: regexp.MustCompile("must be an id")},
+			{Config: config("Renamed", "10000000-0000-0000-0000-000000000002", "20000000-0000-0000-0000-000000000002"), Check: checkCount(5)},
+		},
+		CheckDestroy: func(state *terraform.State) error {
+			fixture.mu.Lock()
+			defer fixture.mu.Unlock()
+			if len(fixture.tokens) != 0 {
+				return fmt.Errorf("tokens remain after destroy")
+			}
+			return nil
+		},
+	})
+}
