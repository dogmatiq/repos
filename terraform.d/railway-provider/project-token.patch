+	client *graphql.Client
+}
+
+type ProjectTokenResourceModel struct {
+	Id            types.String `tfsdk:"id"`
+	Name          types.String `tfsdk:"name"`
+	ProjectId     types.String `tfsdk:"project_id"`
+	EnvironmentId types.String `tfsdk:"environment_id"`
+	Token         types.String `tfsdk:"token"`
+	TokenId       types.String `tfsdk:"token_id"`
+}
+
+func (r *ProjectTokenResource) Metadata(ctx context.Context, req resource.MetadataRequest, resp *resource.MetadataResponse) {
+	resp.TypeName = req.ProviderTypeName + "_project_token"
+}
+
+func (r *ProjectTokenResource) Schema(ctx context.Context, req resource.SchemaRequest, resp *resource.SchemaResponse) {
+	resp.Schema = schema.Schema{
+		MarkdownDescription: "An environment-scoped Railway project token. The credential is stored in sensitive Terraform state and cannot be recovered through import.",
+		Attributes: map[string]schema.Attribute{
+			"id": schema.StringAttribute{
+				MarkdownDescription: "Stable local identifier. The remote token identifier is kept separately so it cannot expose a credential in Terraform's resource summaries.",
+				Computed:            true,
+			},
+			"name": schema.StringAttribute{
+				MarkdownDescription: "Human-readable token name. Changing it replaces the token.",
+				Required:            true,
+				PlanModifiers:       []planmodifier.String{stringplanmodifier.RequiresReplace()},
+				Validators:          []validator.String{stringvalidator.UTF8LengthAtLeast(1)},
+			},
+			"project_id": schema.StringAttribute{
+				MarkdownDescription: "Project that owns the token. Changing it replaces the token.",
+				Required:            true,
+				PlanModifiers:       []planmodifier.String{stringplanmodifier.RequiresReplace()},
+				Validators:          []validator.String{stringvalidator.RegexMatches(uuidRegex(), "must be an id")},
+			},
+			"environment_id": schema.StringAttribute{
+				MarkdownDescription: "Environment that the token can access. Changing it replaces the token.",
+				Required:            true,
+				PlanModifiers:       []planmodifier.String{stringplanmodifier.RequiresReplace()},
+				Validators:          []validator.String{stringvalidator.RegexMatches(uuidRegex(), "must be an id")},
+			},
+			"token": schema.StringAttribute{
+				MarkdownDescription: "Issued credential. Sensitive values are redacted from normal output but remain in Terraform state and plan artifacts.",
+				Computed:            true,
+				Sensitive:           true,
+			},
+			"token_id": schema.StringAttribute{
+				MarkdownDescription: "Railway token record identifier. Kept sensitive because the API's credential and record identifiers must not be assumed to differ.",
+				Computed:            true,
+				Sensitive:           true,
+			},
+		},
+	}
+}
+
+func (r *ProjectTokenResource) Configure(ctx context.Context, req resource.ConfigureRequest, resp *resource.ConfigureResponse) {
+	if req.ProviderData == nil {
+		return
+	}
+
+	client, ok := req.ProviderData.(*graphql.Client)
+	if !ok {
+		resp.Diagnostics.AddError("Unexpected Resource Configure Type", fmt.Sprintf("Expected *graphql.Client, got: %T.", req.ProviderData))
+		return
+	}
+	r.client = client
+}
+
+func (r *ProjectTokenResource) Create(ctx context.Context, req resource.CreateRequest, resp *resource.CreateResponse) {
+	var data ProjectTokenResourceModel
+	resp.Diagnostics.Append(req.Plan.Get(ctx, &data)...)
+	if resp.Diagnostics.HasError() {
+		return
+	}
+
+	localId, err := uuid.GenerateUUID()
+	if err != nil {
+		resp.Diagnostics.AddError("Unable to initialize token", "Could not generate a non-secret identifier for partial creation state.")
+		return
+	}
+
+	// Both calls may carry a credential in the response or request headers.
+	ctx = context.WithValue(ctx, sensitiveRequestKey{}, true)
+	created, err := createProjectToken(ctx, *r.client, ProjectTokenCreateInput{
+		Name:          data.Name.ValueString(),
+		ProjectId:     data.ProjectId.ValueString(),
+		EnvironmentId: data.EnvironmentId.ValueString(),
+	})
+	if err != nil || created.ProjectTokenCreate == "" {
+		resp.Diagnostics.AddError("Unable to create project token", "Railway did not confirm token issuance. Check the project's token settings before retrying: an interrupted request may have issued a token.")
+		return
+	}
+
+	// Retain the one-time credential even if identifying its record fails.
+	data.Id = types.StringValue(localId)
+	data.TokenId = types.StringNull()
+	data.Token = types.StringValue(created.ProjectTokenCreate)
+	resp.Diagnostics.Append(resp.State.Set(ctx, &data)...)
+	if resp.Diagnostics.HasError() {
+		return
+	}
+
+	if err := r.identify(ctx, &data); err != nil {
+		resp.Diagnostics.AddError("Unable to identify project token", "The issued credential has been retained in Terraform state. Restore API access and retry so Terraform can identify and revoke the token before replacing it.")
+		return
+	}
+	resp.Diagnostics.Append(resp.State.Set(ctx, &data)...)
+}
+
+func (r *ProjectTokenResource) Read(ctx context.Context, req resource.ReadRequest, resp *resource.ReadResponse) {
+	ctx = context.WithValue(ctx, sensitiveRequestKey{}, true)
+	var data ProjectTokenResourceModel
+	resp.Diagnostics.Append(req.State.Get(ctx, &data)...)
+	if resp.Diagnostics.HasError() {
+		return
+	}
+
+	if data.TokenId.IsNull() || data.TokenId.IsUnknown() {
+		if err := r.identify(ctx, &data); err != nil {
+			resp.Diagnostics.AddError("Unable to identify project token", "The partially created token remains in state. Restore API access before retrying; its record identifier could not be recovered.")
+			return
+		}
+	}
+
+	info, err := r.find(ctx, data.ProjectId.ValueString(), data.TokenId.ValueString())
+	if err != nil {
+		resp.Diagnostics.AddError("Unable to read project token", "Railway did not confirm the token's state. Check API connectivity and the provider credential's permissions.")
+		return
+	}
+	if info == nil {
+		resp.State.RemoveResource(ctx)
+		return
+	}
+
+	data.Name = types.StringValue(info.Name)
+	data.ProjectId = types.StringValue(info.ProjectId)
+	data.EnvironmentId = types.StringValue(info.EnvironmentId)
+	// Metadata reads never replace the one-time credential saved during creation.
+	resp.Diagnostics.Append(resp.State.Set(ctx, &data)...)
+}
+
+func (r *ProjectTokenResource) Update(ctx context.Context, req resource.UpdateRequest, resp *resource.UpdateResponse) {
+	resp.Diagnostics.AddError("Project token replacement required", "Project tokens do not support in-place updates.")
+}
+
+func (r *ProjectTokenResource) Delete(ctx context.Context, req resource.DeleteRequest, resp *resource.DeleteResponse) {
+	ctx = context.WithValue(ctx, sensitiveRequestKey{}, true)
+	var data ProjectTokenResourceModel
+	resp.Diagnostics.Append(req.State.Get(ctx, &data)...)
+	if resp.Diagnostics.HasError() {
+		return
+	}
+
+	if data.TokenId.IsNull() || data.TokenId.IsUnknown() {
+		if err := r.identify(ctx, &data); err != nil {
+			resp.Diagnostics.AddError("Unable to identify project token", "The partially created token remains in state. Its record identifier must be recovered before it can be revoked.")
+			return
+		}
+	}
+
+	info, err := r.find(ctx, data.ProjectId.ValueString(), data.TokenId.ValueString())
+	if err != nil {
+		resp.Diagnostics.AddError("Unable to read project token", "Railway did not confirm whether the token exists; it has not been removed from Terraform state.")
+		return
+	}
+	if info == nil {
+		return
+	}
+
+	deleted, err := deleteProjectToken(ctx, *r.client, data.TokenId.ValueString())
+	if err != nil || !deleted.ProjectTokenDelete {
+		resp.Diagnostics.AddError("Unable to revoke project token", "Railway did not confirm revocation; the token remains in Terraform state so deletion can be retried.")
+	}
+}
+
+func (r *ProjectTokenResource) identify(ctx context.Context, data *ProjectTokenResourceModel) error {
+	ctx = context.WithValue(ctx, sensitiveRequestKey{}, true)
+	ctx = context.WithValue(ctx, projectTokenAuthKey{}, data.Token.ValueString())
+	result, err := identifyProjectToken(ctx, *r.client)
+	if err != nil {
+		return err
+	}
+	info := result.ProjectToken
+	if info.Id == "" ||
+		info.ProjectId != data.ProjectId.ValueString() || info.EnvironmentId != data.EnvironmentId.ValueString() {
+		return fmt.Errorf("Railway returned an invalid identity or scope")
+	}
+	data.TokenId = types.StringValue(info.Id)
+	return nil
+}
+
+func (r *ProjectTokenResource) find(ctx context.Context, projectId, id string) (*ProjectTokenInfo, error) {
+	var after *string
+	for {
+		page, err := listProjectTokens(ctx, *r.client, projectId, after)
+		if err != nil {
+			var apiErrors gqlerror.List
+			if errors.As(err, &apiErrors) && len(apiErrors) != 0 {
+				missing := true
+				for _, apiError := range apiErrors {
+					missing = missing && apiError.Extensions["code"] == "NOT_FOUND"
+				}
+				if missing {
+					return nil, nil
+				}
+			}
+			return nil, err
+		}
+		for _, edge := range page.ProjectTokens.Edges {
+			if edge.Node.Id == id {
+				return &edge.Node.ProjectTokenInfo, nil
+			}
+		}
+		if !page.ProjectTokens.PageInfo.HasNextPage {
+			return nil, nil
+		}
+		cursor := page.ProjectTokens.PageInfo.EndCursor
+		if cursor == "" || (after != nil && cursor == *after) {
+			return nil, fmt.Errorf("Railway returned an invalid pagination cursor")
+		}
+		after = &cursor
+	}
+}
