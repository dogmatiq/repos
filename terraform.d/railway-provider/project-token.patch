+func TestProjectTokenDebugRedaction(t *testing.T) {
+	t.Setenv("HTTP_DEBUG", "1")
+	file, err := os.CreateTemp(t.TempDir(), "stderr")
+	if err != nil {
+		t.Fatal(err)
+	}
+	previous := os.Stderr
+	os.Stderr = file
+	defer func() { os.Stderr = previous; file.Close() }()
+	fixture := newProjectTokenFixture(t)
+	r, schema := projectTokenTestResource(t, fixture)
+	created := createTestProjectToken(t, r, schema)
+	fixture.deleteFails = true
+	deleted := frameworkresource.DeleteResponse{}
+	r.Delete(context.Background(), frameworkresource.DeleteRequest{State: created.State}, &deleted)
+	file.Seek(0, io.SeekStart)
+	logged, _ := io.ReadAll(file)
+	if strings.Contains(string(logged), "project-secret") || strings.Contains(string(logged), "workspace-secret") {
+		t.Fatal("HTTP debugging exposed a credential")
+	}
+	for _, diagnostic := range deleted.Diagnostics {
+		if strings.Contains(diagnostic.Detail(), "project-secret") {
+			t.Fatal("diagnostic reflected a credential from an API error")
+		}
+	}
+}
