+func TestProjectTokenErrorsAndRevocation(t *testing.T) {
+	fixture := newProjectTokenFixture(t)
+	r, schema := projectTokenTestResource(t, fixture)
+	created := createTestProjectToken(t, r, schema)
+	fixture.listError = "FORBIDDEN"
+	read := frameworkresource.ReadResponse{State: created.State}
+	r.Read(context.Background(), frameworkresource.ReadRequest{State: created.State}, &read)
+	if !read.Diagnostics.HasError() || read.State.Raw.IsNull() {
+		t.Fatal("permission error was mistaken for an absent token")
+	}
+	fixture.listError = ""
+	fixture.deleteFails = true
+	deleted := frameworkresource.DeleteResponse{}
+	r.Delete(context.Background(), frameworkresource.DeleteRequest{State: created.State}, &deleted)
+	if !deleted.Diagnostics.HasError() || len(fixture.tokens) != 1 {
+		t.Fatal("GraphQL error in HTTP 200 was mistaken for successful revocation")
+	}
+	fixture.deleteFails = false
+	fixture.mu.Lock()
+	fixture.tokens = map[string]ProjectTokenInfo{}
+	fixture.mu.Unlock()
+	read = frameworkresource.ReadResponse{State: created.State}
+	r.Read(context.Background(), frameworkresource.ReadRequest{State: created.State}, &read)
+	if read.Diagnostics.HasError() || !read.State.Raw.IsNull() {
+		t.Fatal("confirmed external revocation did not remove the resource")
+	}
+	fixture.listError = "NOT_FOUND"
+	read = frameworkresource.ReadResponse{State: created.State}
+	r.Read(context.Background(), frameworkresource.ReadRequest{State: created.State}, &read)
+	if read.Diagnostics.HasError() || !read.State.Raw.IsNull() {
+		t.Fatal("confirmed project deletion did not remove the resource", read.Diagnostics)
+	}
+}
