+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, req *http.Request) {
+		f.mu.Lock()
+		defer f.mu.Unlock()
+		var request struct {
+			Operation string                     `json:"operationName"`
+			Variables map[string]json.RawMessage `json:"variables"`
+		}
+		if err := json.NewDecoder(req.Body).Decode(&request); err != nil {
+			t.Error(err)
+			w.WriteHeader(http.StatusBadRequest)
+			return
+		}
+		w.Header().Set("Content-Type", "application/json")
+		fail := func(code string) {
+			json.NewEncoder(w).Encode(map[string]interface{}{"errors": []interface{}{map[string]interface{}{
+				"message":    "Reflected dummy credential: project-secret-1",
+				"extensions": map[string]string{"code": code},
+			}}})
+		}
+		respond := func(data interface{}) { json.NewEncoder(w).Encode(map[string]interface{}{"data": data}) }
+		if request.Operation == "identifyProjectToken" {
+			if req.Header.Get("Authorization") != "" || req.Header.Get("Project-Access-Token") == "" {
+				t.Error("identity lookup did not use isolated project-token authentication")
+				fail("FORBIDDEN")
+				return
+			}
+		} else if req.Header.Get("Authorization") != "Bearer workspace-secret" || req.Header.Get("Project-Access-Token") != "" {
+			t.Error("provider credential was modified by a token identity lookup")
+			fail("FORBIDDEN")
+			return
+		}
+		switch request.Operation {
+		case "createProjectToken":
+			var input ProjectTokenCreateInput
+			json.Unmarshal(request.Variables["input"], &input)
+			f.creates++
+			credential := fmt.Sprintf("project-secret-%d", f.creates)
+			id := fmt.Sprintf("30000000-0000-0000-0000-%012d", f.creates)
+			if f.idIsCredential {
+				id = credential
+			}
+			f.tokens[id] = ProjectTokenInfo{Id: id, Name: input.Name, ProjectId: input.ProjectId, EnvironmentId: input.EnvironmentId}
+			f.credentials[credential] = id
+			respond(map[string]string{"projectTokenCreate": credential})
+		case "identifyProjectToken":
+			if f.identifyFails {
+				f.identifyFails = false
+				fail("UNAVAILABLE")
+				return
+			}
+			id := f.credentials[req.Header.Get("Project-Access-Token")]
+			if info, ok := f.tokens[id]; ok {
+				respond(map[string]interface{}{"projectToken": info})
+			} else {
+				fail("FORBIDDEN")
+			}
+		case "listProjectTokens":
+			if f.listError != "" {
+				fail(f.listError)
+				return
+			}
+			var after *string
+			json.Unmarshal(request.Variables["after"], &after)
+			edges := []interface{}{}
+			if after == nil {
+				// A same-name record on another page must not be mistaken for ours.
+				edges = append(edges, map[string]interface{}{"node": ProjectTokenInfo{Id: "unrelated", Name: "CI", ProjectId: tokenTestProject, EnvironmentId: tokenTestEnvironment}})
+			} else {
+				for _, info := range f.tokens {
+					edges = append(edges, map[string]interface{}{"node": info})
+				}
+			}
+			respond(map[string]interface{}{"projectTokens": map[string]interface{}{
+				"edges": edges, "pageInfo": map[string]interface{}{"hasNextPage": after == nil, "endCursor": "next"},
+			}})
+		case "deleteProjectToken":
+			if f.deleteFails {
+				fail("FORBIDDEN")
+				return
+			}
+			var id string
+			json.Unmarshal(request.Variables["id"], &id)
+			if _, ok := f.tokens[id]; !ok {
+				t.Error("delete did not target an owned record")
+				respond(map[string]bool{"projectTokenDelete": false})
+				return
+			}
+			delete(f.tokens, id)
+			f.deletes++
+			respond(map[string]bool{"projectTokenDelete": true})
+		default:
+			t.Errorf("unexpected operation %q", request.Operation)
+			fail("UNKNOWN")
+		}
+	}))
+	t.Cleanup(server.Close)
+	f.client = graphql.NewClient(server.URL, &http.Client{Transport: &authedTransport{token: "workspace-secret", wrapped: http.DefaultTransport}})
+	return f
+}
