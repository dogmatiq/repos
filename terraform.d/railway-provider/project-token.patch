+func TestProjectTokenLifecycle(t *testing.T) {
+	for _, identical := range []bool{false, true} {
+		t.Run(fmt.Sprintf("record-id-equals-credential=%t", identical), func(t *testing.T) {
+			fixture := newProjectTokenFixture(t)
+			fixture.idIsCredential = identical
+			r, schema := projectTokenTestResource(t, fixture)
+			created := createTestProjectToken(t, r, schema)
+			if created.Diagnostics.HasError() {
+				t.Fatal(created.Diagnostics)
+			}
+			var initial ProjectTokenResourceModel
+			created.State.Get(context.Background(), &initial)
+			if initial.Token.ValueString() != "project-secret-1" || initial.Id.ValueString() == initial.Token.ValueString() {
+				t.Fatal("one-time credential was lost or exposed as the resource identifier")
+			}
+			if !schema.Schema.Attributes["token"].IsSensitive() || !schema.Schema.Attributes["token_id"].IsSensitive() {
+				t.Fatal("credentials and API identifiers must be schema-sensitive")
+			}
+			read := frameworkresource.ReadResponse{State: tfsdk.State{Schema: schema.Schema}}
+			r.Read(context.Background(), frameworkresource.ReadRequest{State: created.State}, &read)
+			if read.Diagnostics.HasError() {
+				t.Fatal(read.Diagnostics)
+			}
+			var refreshed ProjectTokenResourceModel
+			read.State.Get(context.Background(), &refreshed)
+			if refreshed != initial || fixture.creates != 1 {
+				t.Fatal("refresh changed the credential or issued another token")
+			}
+			deleted := frameworkresource.DeleteResponse{}
+			r.Delete(context.Background(), frameworkresource.DeleteRequest{State: read.State}, &deleted)
+			if deleted.Diagnostics.HasError() || fixture.deletes != 1 || len(fixture.tokens) != 0 {
+				t.Fatal("token was not revoked by record ID", deleted.Diagnostics)
+			}
+			// A second deletion is harmless when metadata confirms absence.
+			r.Delete(context.Background(), frameworkresource.DeleteRequest{State: read.State}, &deleted)
+			if deleted.Diagnostics.HasError() || fixture.deletes != 1 {
+				t.Fatal("already-absent token deletion was not idempotent")
+			}
+		})
+	}
+}
