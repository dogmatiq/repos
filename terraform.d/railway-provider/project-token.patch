+func TestProjectTokenPartialCreation(t *testing.T) {
+	fixture := newProjectTokenFixture(t)
+	fixture.identifyFails = true
+	r, schema := projectTokenTestResource(t, fixture)
+	created := createTestProjectToken(t, r, schema)
+	if !created.Diagnostics.HasError() {
+		t.Fatal("expected identification failure")
+	}
+	var partial ProjectTokenResourceModel
+	if diagnostics := created.State.Get(context.Background(), &partial); diagnostics.HasError() {
+		t.Fatal(diagnostics)
+	}
+	if partial.Token.ValueString() != "project-secret-1" || !partial.TokenId.IsNull() || partial.Id.IsUnknown() {
+		t.Fatal("partial creation did not preserve the issued credential")
+	}
+	read := frameworkresource.ReadResponse{State: tfsdk.State{Schema: schema.Schema}}
+	r.Read(context.Background(), frameworkresource.ReadRequest{State: created.State}, &read)
+	if read.Diagnostics.HasError() || fixture.creates != 1 {
+		t.Fatal("partial creation could not recover without issuing another token", read.Diagnostics)
+	}
+	deleted := frameworkresource.DeleteResponse{}
+	r.Delete(context.Background(), frameworkresource.DeleteRequest{State: read.State}, &deleted)
+	if deleted.Diagnostics.HasError() || fixture.deletes != 1 {
+		t.Fatal("recovered partial token could not be revoked", deleted.Diagnostics)
+	}
+}
